# LifeAtlas — environment configuration
#
# Part One needs NONE of these. With no .env file at all, the app runs as a
# local demo: sample family, browser storage, mock services, nothing sent.
# Copy to .env.local only if you want to change a default below.

# --- Runtime (used today) ---------------------------------------------------

# "demo" (default) uses local mock services. "production" swaps every service
# for a stub that returns `not_configured` until Part Two connects it.
NEXT_PUBLIC_LIFEATLAS_MODE=demo

# Canonical site URL, used for the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 0 to remove the small artificial delays that exercise loading states.
NEXT_PUBLIC_DEMO_LATENCY=

# Optional: an existing Chromium for Playwright (`npm run test:e2e`).
PLAYWRIGHT_CHROMIUM_PATH=
E2E_PORT=3100

# --- Part Two (NOT read by Part One — listed so nothing is a surprise) -------
# Names are indicative; see docs/INTEGRATIONS_PART_TWO.md. Server-only secrets
# must never use the NEXT_PUBLIC_ prefix.

# Database & accounts
# DATABASE_URL=
# AUTH_SECRET=
# AUTH_PROVIDER_ISSUER=
# AUTH_PROVIDER_CLIENT_ID=
# AUTH_PROVIDER_CLIENT_SECRET=

# Media storage (private bucket, server-side encryption, signed URLs)
# MEDIA_BUCKET=
# MEDIA_REGION=
# MEDIA_KMS_KEY_ID=
# MEDIA_ACCESS_KEY_ID=
# MEDIA_SECRET_ACCESS_KEY=

# Independent backups (different provider and region from MEDIA_*)
# BACKUP_BUCKET=
# BACKUP_REGION=
# BACKUP_CREDENTIALS=

# Payments
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email / SMS for invitations
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM_ADDRESS=
# SMS_PROVIDER_API_KEY=

# Speech-to-text (opt-in, per recording)
# TRANSCRIPTION_API_KEY=

# Place search and map tiles
# GEOCODER_API_KEY=
# MAP_TILES_URL=

# Print & fulfillment
# PRINT_VENDOR_API_KEY=
# SHIPPING_CARRIER_API_KEY=
# TAX_SERVICE_API_KEY=

# Analytics (consent-based)
# ANALYTICS_WRITE_KEY=
